<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0
         http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <groupId>world.willfrog</groupId>
    <artifactId>datafrog</artifactId>
    <version>0.1.0-SNAPSHOT</version>
    <packaging>pom</packaging>

    <name>datafrog</name>
    <description>DataFrog data platform monolith. Mirrors the alphafrog-micro service shape so Beta/production tooling works the same way.</description>

    <properties>
        <maven.compiler.source>17</maven.compiler.source>
        <maven.compiler.target>17</maven.compiler.target>
        <maven.compiler.release>17</maven.compiler.release>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <!-- 版本与 alphafrog-micro 根 pom 对齐，保证两套服务运行在同一套依赖基线上 -->
        <dubbo.version>3.3.2</dubbo.version>
        <spring-boot.version>3.2.3</spring-boot.version>
        <protobuf-java.version>3.25.3</protobuf-java.version>
        <protoc.version>3.25.3</protoc.version>
    </properties>

    <dependencyManagement>
        <dependencies>
            <dependency>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-dependencies</artifactId>
                <version>${spring-boot.version}</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>
        </dependencies>
    </dependencyManagement>

    <modules>
        <module>datafrog-api</module>
        <module>datafrog-server</module>
    </modules>

    <build>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-compiler-plugin</artifactId>
                <version>3.13.0</version>
            </plugin>
            <!-- 钉 Surefire 版本：Maven 3.6 系的默认 Surefire 2.12.4 走 JUnit 3 提供器，
                 会静默跳过 JUnit 5 测试（BUILD SUCCESS 但 Tests run: 0）。钉 3.5.2 后
                 任何 Maven 版本下测试都真实执行。 -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-surefire-plugin</artifactId>
                <version>3.5.2</version>
            </plugin>
        </plugins>
    </build>
</project>
